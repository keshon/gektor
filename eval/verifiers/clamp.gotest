package clamp

import "testing"

func TestAcceptanceClamp(t *testing.T) {
	for _, tc := range []struct{ value, low, high, want int }{
		{-5, 0, 10, 0}, {15, 0, 10, 10}, {5, 0, 10, 5},
		{0, 0, 10, 0}, {10, 0, 10, 10}, {-8, -5, -1, -5},
		{5, 3, 3, 3}, {1, 3, 3, 3},
	} {
		if got := Clamp(tc.value, tc.low, tc.high); got != tc.want {
			t.Errorf("Clamp(%d,%d,%d)=%d; want %d",tc.value,tc.low,tc.high,got,tc.want)
		}
	}
}
