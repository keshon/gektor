package ledger

import (
	"fmt"
	"math/rand"
	"os/exec"
	"strings"
	"testing"
)

func TestAcceptanceAmounts(t *testing.T) {
	for _, tc := range []struct {
		values []string
		want   int
	}{
		{nil, 0}, {[]string{"1", "1.2", "1.23"}, 343},
		{[]string{" 10.00 ", "0.50", "-1.25", "2.10"}, 1135},
		{[]string{"-0.05", "+1.2", "-2"}, -85},
	} {
		got, err := TotalCents(tc.values)
		if err != nil || got != tc.want {
			t.Fatalf("%q => %d,%v; want %d", tc.values, got, err, tc.want)
		}
	}
	for _, value := range []string{"", " ", "one", "1.234", "1.2.3", "1e2", "--1", "+", "0x10"} {
		if _, err := TotalCents([]string{"1.00", value}); err == nil {
			t.Fatalf("accepted invalid amount %q", value)
		}
	}
	rng := rand.New(rand.NewSource(731))
	values := []string{}
	want := 0
	for i := 0; i < 50; i++ {
		n := rng.Intn(100000)
		values = append(values, fmt.Sprintf("%d.%02d", n/100, n%100))
		want += n
	}
	if got, err := TotalCents(values); err != nil || got != want {
		t.Fatalf("sum=%d,%v; want %d", got, err, want)
	}
}

func TestAcceptanceCLI(t *testing.T) {
	out, err := exec.Command("go", "run", "./cmd/ledger", "1.20", "2.03").CombinedOutput()
	if err != nil || strings.TrimSpace(string(out)) != "323" {
		t.Fatalf("CLI: %q %v", out, err)
	}
	if out, err := exec.Command("go", "run", "./cmd/ledger", "oops").CombinedOutput(); err == nil || len(out) == 0 {
		t.Fatalf("CLI accepted invalid input: %q %v", out, err)
	}
}
