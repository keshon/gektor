# TARS launcher configuration. Copy to .env and fill in your paths/keys.
# .env is gitignored — never commit real paths or credentials.

# ============================================================
# llama.cpp server  (default backend — run-server-llama.cmd)
# ============================================================
# Example:
#   LLAMA_SERVER_EXE=e:\Projects\ai-text\llamacpp\llama-server.exe
#   LLAMA_MODEL=e:\Projects\ai-text\models\llama\Qwen3.5-9B-Q4_K_M.gguf
LLAMA_SERVER_EXE=
LLAMA_MODEL=
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CTX_SIZE=65536
LLAMA_GPU_LAYERS=20
LLAMA_BATCH_SIZE=512
LLAMA_ARGS=

# ============================================================
# KoboldCPP server  (run-server-kobold.cmd — secondary)
# ============================================================
# Example:
#   KOBOLD_EXE=e:\Projects\ai-text\koboldcpp-extracted\koboldcpp-launcher.exe
#   KOBOLD_MODEL=e:\Projects\ai-text\models\unsloth\Qwen3.5-9B-GGUF\Qwen3.5-9B-Q4_K_M.gguf
KOBOLD_EXE=
KOBOLD_MODEL=
KOBOLD_HOST=127.0.0.1
KOBOLD_PORT=5001
KOBOLD_USE_CUDA=0
KOBOLD_GPU_LAYERS=999
KOBOLD_CONTEXT_SIZE=65536
KOBOLD_QUANT_KV=1
KOBOLD_ARGS=

# ============================================================
# OpenAI-compatible / remote backend  (run-server-openai.cmd, run-remote.cmd)
# ============================================================
# TARS_API_KEY is the generic name: internal/llm.APIKeyFromEnv reads it
# ahead of OPENAI_API_KEY, OPENROUTER_API_KEY and the rest. The OPENAI_*
# endpoint settings describe this backend, like LLAMA_* and KOBOLD_*.
TARS_API_KEY=
OPENAI_BACKEND=https://openrouter.ai/api/v1
OPENAI_MODEL=cohere/north-mini-code:free
OPENAI_WORKSPACE=.