# GEKTOR reads API keys from the process environment, not from .env.
# PowerShell: $env:GEKTOR_API_KEY = "your-key"
# Other supported key variables are listed in docs/cli.md.
GEKTOR_API_KEY=

# Optional scripts/bench-llama.cmd reads LLAMA_* and BENCH_* from .env.
# These settings belong to the external llama-bench tool, not GEKTOR.
BENCH_EXE=
LLAMA_MODEL=
LLAMA_GPU_LAYERS=999
