.gektor/
# Another agent's worktrees (kilo). A full second checkout of this repo,
# including its own .git file — never source, never committed.
.kilo/
sandbox/
temp/
*.exe
*.exe~
dump.txt
dump.bat
agent-debug.log
agent-frontend.log
agent-backend.log
plan.md
eval/results/
eval/log/
# Benchmark output. bench-llama.cmd stamps a fresh directory per run.
bench-results/
tmp/
# Local environment (machine-specific paths and keys) — never committed.
.env
# Local launchers holding live API keys are never committed.
run-remote.cmd
# Local serve launcher (ports and backends are machine-specific).
run-serve.cmd

# Local session state and model assets. Nothing here is read by the agent.
/var/
/bin/
/assets/models/

/assets/manifest.json

# Per-user setup snapshots created by Settings Apply.
/profiles/custom/

*.png
/bench-results
*.csv

# Public TUI preview used by the README.
!/docs/images/gektor-demo.png
/design/website
