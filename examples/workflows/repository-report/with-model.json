{
  "version": 4,
  "name": "Review a model-assisted repository report",
  "inputs": {
    "record_id": {
      "type": "string",
      "default": "gektor"
    }
  },
  "steps": [
    {
      "id": "fetch",
      "tool": "http_request",
      "args": {
        "url": "https://api.github.com/repos/keshon/gektor",
        "headers": {
          "Accept": "application/vnd.github+json"
        }
      }
    },
    {
      "id": "normalize",
      "tool": "script_transform",
      "args": {
        "input": {
          "$step": "fetch",
          "pointer": "/data"
        },
        "code": "return {repository: input.full_name, description: input.description || \"\", stars: input.stargazers_count, open_issues: input.open_issues_count};"
      }
    },
    {
      "id": "summarize",
      "tool": "model_generate",
      "args": {
        "profile": "profile.json",
        "prompt": "Summarize this repository metadata in one short factual sentence. Do not infer code quality or activity from these counts. Return JSON with summary.",
        "input": {
          "$step": "normalize"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        },
        "max_tokens": 512
      }
    },
    {
      "id": "merge",
      "tool": "script_transform",
      "args": {
        "input": {
          "record": {
            "$step": "normalize"
          },
          "summary": {
            "$step": "summarize",
            "pointer": "/data/summary"
          }
        },
        "code": "return {...input.record, summary: input.summary};"
      }
    },
    {
      "id": "save",
      "tool": "record_write",
      "review": true,
      "args": {
        "kind": "repository_reports",
        "id": {
          "$input": "record_id"
        },
        "expected_revision": 0,
        "data": {
          "$step": "merge"
        }
      }
    }
  ]
}
