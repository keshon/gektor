{
  "name": "gektor-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "node --check src/main.js && node --check src/docs.js && node --check scripts/prepare-assets.mjs && node scripts/check-docs.mjs && node --test scripts/documentation.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "github-slugger": "2.0.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
